{
  "name": "d365-auto-recorder-pom-generator",
  "version": "1.0.0",
  "description": "Desktop tool for recording D365 flows and generating Playwright POMs and test specs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "build:ui": "cd src/ui && npm run build",
    "build:all": "npm run build && npm run build:ui",
    "build:app": "npm run build:all",
    "start": "electron dist/main/index.js",
    "dev": "tsc && npm run build:ui && electron dist/main/index.js",
    "dev:electron": "tsc && electron dist/main/index.js",
    "dev:ui": "cd src/ui && npm run dev",
    "dev:watch": "tsc --watch",
    "install:all": "npm install && cd src/ui && npm install",
    "dist": "npm run build:app && electron-builder",
    "dist:win": "npm run build:app && electron-builder --win",
    "dist:win:dir": "npm run build:app && electron-builder --win --dir",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "keywords": [
    "playwright",
    "d365",
    "pom",
    "test-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.3.1",
    "electron-store": "^11.0.2",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/electron-store": "^1.3.1",
    "@types/node": "^20.10.0",
    "electron": "^27.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.3.0"
  },
  "build": {
    "appId": "com.fourhands.d365.autorecorder",
    "productName": "D365 Auto Recorder & POM Generator",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*",
      "dist/ui/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/@playwright/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
